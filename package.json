{
  "name": "json-forms-web-preview",
  "displayName": "JSONForms Remote Preview",
  "description": "VSCode extension to render JSONForms schemas using a remote renderer",
  "publisher": "ShipitSmarter",
  "icon": "img/icon.png",
  "author": {
    "name": "ShipitSmarter",
    "url": "https://github.com/ShipitSmarter"
  },
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.134.0"
  },
  "contributors": [
    {
      "name": "Michael Stocks",
      "url": "https://github.com/Droxx",
      "email": "michaelstocks1@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ShipitSmarter/vscode-jsonforms-preview"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "form",
    "forms",
    "json",
    "jsonforms",
    "frontend",
    "preview",
    "render",
    "jsonschema",
    "schema",
    "uischema",
    "layout",
    "template"
  ],
  "activationEvents": [
    "workspaceContains:**/**json",
    "workspaceContains:**/**yaml",
    "onLanguage:json",
    "onLanguage:yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "json-forms-web-preview.rightClickSchema",
        "title": "Open JSONForms Web-Preview",
        "enablement": "resourceExtname == .json || resourceExtname == .yaml"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "json-forms-web-preview.rightClickSchema",
          "when": "resourceExtname == .json || resourceExtname == .yaml"
        }
      ],
      "explorer/context": [
        {
          "group": "3_jsonforms_preview",
          "command": "json-forms-web-preview.rightClickSchema",
          "when": "resourceExtname == .json || resourceExtname == .yaml"
        }
      ],
      "editor/title": [
        {
          "group": "3_jsonforms_preview",
          "command": "json-forms-web-preview.rightClickSchema",
          "when": "resourceExtname == .json || resourceExtname == .yaml"
        }
      ],
      "editor/title/context": [
        {
          "group": "3_jsonforms_preview",
          "command": "json-forms-web-preview.rightClickSchema",
          "when": "resourceExtname == .json|| resourceExtname == .yaml"
        }
      ]
    },
    "configuration": {
      "title": "JSONForms remote-preview",
      "properties": {
        "json-forms-web-preview.render-url": {
          "type": "string",
          "default": "https://shipitsmarter.github.io/viya-app",
          "pattern": "(http:|https:)+[^\\s]+[\\w]",
          "description": "URL to render JSON Schema"
        },
        "json-forms-web-preview.debounce-timeout": {
          "type": "number",
          "default": 500,
          "description": "Amount of ms to wait with no changes before reloading preview",
          "minimum": 200
        },
        "json-forms-web-preview.async-fetch.tenant-url": {
          "type": "string",
          "default": "",
          "description": "Optional URL to fetch dummy data from for custom ui schema elements containing `asyncFetch`"
        },
        "json-forms-web-preview.async-fetch.token": {
          "type": "string",
          "default": "",
          "description": "Optional token to be sent in the header for the api call for custom ui schema elements containing `asyncFetch`"
        },
        "json-forms-web-preview.async-fetch.token-header-name": {
          "type": "string",
          "default": "",
          "description": "Optional header name for the token to be sent in the api call for custom ui schema elements containing `asyncFetch`"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "deploy": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.134.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.9.1",
    "html-loader": "^5.1.0",
    "mocha": "^10.2.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "typescript-eslint": "^8.69.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "yaml": "^2.9.0"
  }
}
